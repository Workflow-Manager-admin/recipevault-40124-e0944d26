    Recipes
  </h1>
  <div style="margin:.7rem 0 2rem;color:#666;">
    {/* Placeholder for recipe search/filter and call-to-action */}
    <input type="text" placeholder="Search recipes…" style="padding:.4rem 1rem; border-radius:2rem; border:1px solid #ddd; width:65%;max-width:400px;" />
    <a href="#" style="background:var(--color-accent);color:#fff;font-weight:600;display:inline-block;padding:0.5rem 1.1rem;border-radius:2rem;margin-left:1rem;font-size:.96rem;">
      + Add Recipe
    </a>
  </div>
  <div>
    <p style="color:#888;margin-top:2rem;">No recipes found. (Placeholder content)</p>
  </div>
</section>
